                }
              }
            },
            "description": "Request outside the supported range"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters"
          }
        },
        "summary": "Delivery window and defaults",
        "tags": [
          "reference"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "What the forecast said when the buyer had to commit",
      "name": "decision"
    },
    {
      "description": "How forecast error depends on lead time",
      "name": "accuracy"
    },
    {
      "description": "Window and defaults the UI needs",
