                }
              }
            },
            "description": "Invalid parameters"
          }
        },
        "summary": "Liveness and loaded dataset",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
