  "info": {
    "description": "GB wind forecasts available at day-ahead gate closure, and how accurate they were.",
    "title": "GridBrick API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/accuracy": {
      "get": {
        "operationId": "accuracy_api_v1_accuracy_get",
        "parameters": [
          {
            "description": "Minimum hours between forecast publication and delivery",
            "in": "query",
            "name": "horizon",
            "required": false,
            "schema": {
              "default": 24,
              "description": "Minimum hours between forecast publication and delivery",
              "maximum": 48,
              "minimum": 0,
              "title": "Horizon",
              "type": "integer"
            }
          },
          {
            "description": "First delivery day to include (default: start of window)",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First delivery day to include (default: start of window)",
              "title": "Start"
            }
          },
          {
            "description": "Last delivery day to include, inclusive (default: end of window)",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last delivery day to include, inclusive (default: end of window)",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccuracyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request outside the supported range"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters"
          }
        },
        "summary": "Forecast accuracy at one horizon",
        "tags": [
          "accuracy"
        ]
      }
    },
    "/api/v1/accuracy/by-horizon": {
      "get": {
        "operationId": "by_horizon_api_v1_accuracy_by_horizon_get",
        "parameters": [
          {
            "description": "First delivery day to include (default: start of window)",
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "First delivery day to include (default: start of window)",
              "title": "Start"
            }
          },
          {
            "description": "Last delivery day to include, inclusive (default: end of window)",
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Last delivery day to include, inclusive (default: end of window)",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/HorizonRow"
                  },
                  "title": "Response By Horizon Api V1 Accuracy By Horizon Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request outside the supported range"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters"
          }
        },
        "summary": "Error metrics for every 3 h horizon from 0 to 48 h",
        "tags": [
          "accuracy"
        ]
      }
    },
    "/api/v1/decision": {
      "get": {
        "operationId": "decision_api_v1_decision_get",
        "parameters": [
          {
            "description": "Delivery day (UTC), 2026-01-02 to 2026-02-01",
            "in": "query",
            "name": "delivery_date",
            "required": true,
            "schema": {
              "description": "Delivery day (UTC), 2026-01-02 to 2026-02-01",
              "examples": [
                "2026-01-15"
              ],
              "format": "date",
              "title": "Delivery Date",
              "type": "string"
            }
          },
          {
            "description": "Gate closure on D-1, HH:MM UTC",
            "in": "query",
            "name": "gate_time",
            "required": false,
            "schema": {
              "default": "09:20:00",
              "description": "Gate closure on D-1, HH:MM UTC",
              "examples": [
                "09:20"
              ],
              "format": "time",
              "title": "Gate Time",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request outside the supported range"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid parameters"
          }
        },
        "summary": "Forecast available at gate closure for one delivery day",
        "tags": [
          "decision"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
